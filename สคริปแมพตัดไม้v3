-- ฟังก์ชันช่วยวาร์ปแบบปลอดภัย (กันจมดิน)
local function forceTeleport(coords)
    local char = game.Players.LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = CFrame.new(coords) + Vector3.new(0, 4, 0)
        Rayfield:Notify({
            Title = "CRIMSON TELEPORT", 
            Content = "วาร์ปถึงจุดหมายเรียบร้อย!", 
            Duration = 2.5,
            Image = CrimsonCoverImage
        })
    end
end

