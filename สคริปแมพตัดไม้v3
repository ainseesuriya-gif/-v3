local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- สร้างหน้าต่างสคริปต์หลัก
local Window = Rayfield:CreateWindow({
   Name = "CRIMSON LT2 HUB v1.0 🩸🖤",
   LoadingTitle = "กำลังโหลดระบบ CRIMSON ENGINE...",
   LoadingSubtitle = "by Assistant AI",
   ConfigurationSaving = { Enabled = false },
   Theme = "Crimson" -- โทนสีแดง-ดำ เท่ๆ ดุดัน
})

-- ฟังก์ชันช่วยวาร์ปแบบปลอดภัย (กันจมดิน / ตกแมพ)
local function safeTeleport(targetCFrame)
    local char = game.Players.LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = targetCFrame + Vector3.new(0, 4, 0)
    end
end

-- ==================== TAB 1: ไม้ทุกชนิด (ALL TREES BY TIERS) ====================
local WoodTab = Window:CreateTab("ไม้ทุกชนิด (Tree Tiers)", 4483362458)

-- Tier 1: ระดับตำนาน (Mythical / God Tier)
WoodTab:CreateSection("🔥 [GOD TIER] ไม้ระดับตำนาน / หายากที่สุด")

local GodTrees = {
    ["🌌 End Times Wood (ไม้ Phantom/หลุมดำ)"] = "EndTimes",
    ["🌋 Volcano Wood (ไม้ลาวา/ภูเขาไฟ)"] = "Volcano",
    ["✨ Gold Swirly Wood (ไม้ทองสว่าง)"] = "Gold",
    ["💎 Cave Wood (ไม้ถ้ำฟ้า)"] = "Cave"
}

for name, tag in pairs(GodTrees) do
    WoodTab:CreateButton({
        Name = name,
        Callback = function()
            local found = false
            for _, obj in ipairs(workspace:GetChildren()) do
                if (obj.Name == "TreeRegion" or obj:FindFirstChild("WoodSection")) and string.find(string.lower(obj.Name), string.lower(tag)) then
                    local part = obj:FindFirstChildWhichIsA("BasePart", true)
                    if part then safeTeleport(part.CFrame) found = true break end
                end
            end
            if not found then Rayfield:Notify({Title = "CRIMSON NOTIFY", Content = "ไม่พบต้นไม้ หรือระบบยังไม่โหลดฉาก", Duration = 2.5}) end
        end,
    })
end

