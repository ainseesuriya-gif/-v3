-- ==================== TAB 3: ดึงไม้ & ขายเงิน (LOGS & FARM) ====================
local FarmTab = Window:CreateTab("ดึงไม้ & ขายเงิน (Farm)", CrimsonCoverImage)

FarmTab:CreateSection("🧲 ระบบจัดการท่อนไม้")

FarmTab:CreateButton({
   Name = "🧲 ดึงท่อนไม้ที่ตัดแล้วทั้งหมดมาหาตัว",
   Callback = function()
        local char = game.Players.LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        
        local count = 0
        for _, item in ipairs(workspace:GetChildren()) do
            if item.Name == "Log" or item.Name == "Plank" or item:FindFirstChild("WoodSection") or item.Name == "TreeRegion" then
                for _, part in ipairs(item:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CFrame = char.HumanoidRootPart.CFrame + Vector3.new(0, 3, -5)
                        count = count + 1
                    end
                end
            end
        end
        Rayfield:Notify({
            Title = "CRIMSON HUB", 
            Content = "ดึงไม้สำเร็จ " .. tostring(count) .. " ชิ้น!", 
            Duration = 3,
            Image = CrimsonCoverImage
        })
   end,
})

FarmTab:CreateButton({
   Name = "💰 วาร์ปส่งไม้ทั้งหมดเข้าเครื่องขายเงิน",
   Callback = function()
        local dropoffPos = Vector3.new(315, 3, -1300) -- พิกัดแท่นขายไม้ร้าน Woodman
        local count = 0
        for _, item in ipairs(workspace:GetChildren()) do
            if item.Name == "Log" or item.Name == "Plank" or item:FindFirstChild("WoodSection") or item.Name == "TreeRegion" then
                for _, part in ipairs(item:GetDescendants()) do
                    if part:IsA("BasePart") and (part.Name == "Wood" or part.Name == "Main") then
                        part.CFrame = CFrame.new(dropoffPos) + Vector3.new(0, 4, 0)
                        count = count + 1
                    end
                end
            end
        end
        Rayfield:Notify({
            Title = "ขายสำเร็จ!", 
            Content = "ส่งไม้จำนวน " .. tostring(count) .. " ชิ้นเข้าจุดขายเรียบร้อย", 
            Duration = 3,
            Image = CrimsonCoverImage
        })
   end,
})
