-- ==================== TAB 2: ร้านค้าทั้งหมด (ALL STORES) ====================
local StoreTab = Window:CreateTab("ร้านค้าทั้งหมด (Stores)", 4483362458)

StoreTab:CreateSection("🏪 รวมวาร์ปหน้าร้านค้าทุกแห่งในแผนที่")

local AllStores = {
    ["🪓 Woodman's Store (ร้านขายขวาน/อุปกรณ์หลัก)"] = "Woodman",
    ["🛋️ Fancy Furnishings (ร้านเฟอร์นิเจอร์/ขวาน Silver)"] = "Furniture",
    ["🚗 Boxed Cars / Land Store (ร้านซื้อที่ดิน & รถยนต์)"] = "Car",
    ["🔨 Fine Supply Store (ร้านเครื่องมือพิเศษ)"] = "FineSupply",
    ["🎨 Logic Store (ร้านอุปกรณ์สายไฟ & ลอจิก)"] = "Logic",
    ["⛵ Shack Store (ร้านค้าบนเกาะ/ชายหาด)"] = "Shack"
}

for displayName, searchTag in pairs(AllStores) do
    StoreTab:CreateButton({
        Name = displayName,
        Callback = function()
            local found = false
            if workspace:FindFirstChild("Stores") then
                for _, store in ipairs(workspace.Stores:GetChildren()) do
                    if string.find(store.Name, searchTag) then
                        local pad = store:FindFirstChild("Counter") or store:FindFirstChild("BuyPad") or store:FindFirstChild("WoodDropoff") or store:FindFirstChildWhichIsA("BasePart")
                        if pad then
                            safeTeleport(pad.CFrame)
                            found = true
                            Rayfield:Notify({Title = "วาร์ปสำเร็จ!", Content = "เดินทางถึง " .. displayName, Duration = 2})
                            break
                        end
                    end
                end
            end
            if not found then
                Rayfield:Notify({Title = "ข้อผิดพลาด", Content = "ไม่พบโมเดลร้านค้าในเซิร์ฟเวอร์", Duration = 2.5})
            end
        end,
    })
end

-- ==================== TAB 3: ดึงไม้ & ขายเงิน (AUTO FARM & LOGS) ====================
local FarmTab = Window:CreateTab("ดึงไม้ & ขายเงิน (Farm)", 4483362458)

FarmTab:CreateSection("🧲 ระบบจัดการท่อนไม้")

FarmTab:CreateButton({
   Name = "🧲 ดึงท่อนไม้ที่ตัดแล้วทั้งหมดมาหาตัว",
   Callback = function()
        local char = game.Players.LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        
        local count = 0
        for _, item in ipairs(workspace:GetChildren()) do
            if item.Name == "Log" or item.Name == "Plank" or item:FindFirstChild("WoodSection") then
                for _, part in ipairs(item:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CFrame = char.HumanoidRootPart.CFrame + Vector3.new(0, 3, -5)
                        count = count + 1
                    end
                end
            end
        end
        Rayfield:Notify({Title = "CRIMSON HUB", Content = "ดึงไม้ทั้งหมดจำนวน " .. tostring(count) .. " ชิ้นมาที่ตัวแล้ว", Duration = 3})
   end,
})

FarmTab:CreateButton({
   Name = "💰 วาร์ปส่งไม้ทั้งหมดเข้าเครื่องขายเงิน (Dropoff)",
   Callback = function()
        local dropoffPart = nil
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name == "WoodDropoff" and obj:IsA("BasePart") then
                dropoffPart = obj
                break
            end
        end

        if not dropoffPart then
            Rayfield:Notify({Title = "แจ้งเตือน", Content = "ไม่พบแท่นขาย! กรุณาวาร์ปไป Woodman's Store ก่อน", Duration = 3})
            return
        end

        local count = 0
        for _, item in ipairs(workspace:GetChildren()) do
            if item.Name == "Log" or item.Name == "Plank" or item:FindFirstChild("WoodSection") or item.Name == "TreeRegion" then
                for _, part in ipairs(item:GetDescendants()) do
                    if part:IsA("BasePart") and (part.Name == "Wood" or part.Name == "Main") then
                        part.CFrame = dropoffPart.CFrame + Vector3.new(0, 4, 0)
                        count = count + 1
                    end
                end
            end
        end
        Rayfield:Notify({Title = "ขายสำเร็จ!", Content = "ส่งไม้จำนวน " .. tostring(count) .. " ชิ้นเข้าจุดขายแล้ว", Duration = 3})
   end,
})
